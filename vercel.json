{
  "functions": {
    "api/paid-content.ts": {
      "includeFiles": "docs/content/articles/*.md"
    },
    "api/article-page.ts": {
      "includeFiles": "docs/content/**/*.md"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:code",
      "destination": "/api/share?code=:code"
    },
    {
      "source": "/api/content/:slug",
      "destination": "/api/paid-content?slug=:slug"
    },
    {
      "source": "/types/compatibility",
      "destination": "/index.html"
    },
    {
      "source": "/types/:code",
      "destination": "/api/share?code=:code&render=app"
    },
    {
      "source": "/watch/:slug",
      "destination": "/api/article-page?slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/index.html"
    },
    {
      "source": "/data-deletion",
      "destination": "/index.html"
    },
    {
      "source": "/my-result",
      "destination": "/index.html"
    },
    {
      "source": "/journal/history",
      "destination": "/index.html"
    },
    {
      "source": "/preview-results",
      "destination": "/index.html"
    },
    {
      "source": "/reading-prototype",
      "destination": "/index.html"
    },
    {
      "source": "/daily-awareness-result",
      "destination": "/index.html"
    },
    {
      "source": "/deep-dive",
      "destination": "/index.html"
    },
    {
      "source": "/research-admin",
      "destination": "/index.html"
    },
    {
      "source": "/me",
      "destination": "/index.html"
    },
    {
      "source": "/mirror-trade",
      "destination": "/index.html"
    },
    {
      "source": "/types",
      "destination": "/index.html"
    },
    {
      "source": "/watch",
      "destination": "/index.html"
    },
    {
      "source": "/survival-kit",
      "destination": "/index.html"
    },
    {
      "source": "/guide",
      "destination": "/index.html"
    },
    {
      "source": "/guide/line",
      "destination": "/index.html"
    },
    {
      "source": "/manual",
      "destination": "/index.html"
    },
    {
      "source": "/test",
      "destination": "/index.html"
    },
    {
      "source": "/test-mockup",
      "destination": "/index.html"
    },
    {
      "source": "/daily-awareness",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/coach",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/not-found"
    }
  ]
}
