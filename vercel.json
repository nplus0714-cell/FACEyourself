{
  "functions": {
    "api/paid-content.ts": {
      "includeFiles": "docs/content/articles/*.md"
    }
  },
  "rewrites": [
    {
      "source": "/share/:code",
      "destination": "/api/share?code=:code"
    },
    {
      "source": "/api/content/:slug",
      "destination": "/api/paid-content?slug=:slug"
    },
    {
      "source": "/types/compatibility",
      "destination": "/index.html"
    },
    {
      "source": "/types/:code",
      "destination": "/api/share?code=:code&render=app"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
