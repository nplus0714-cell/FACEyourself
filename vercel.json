{
  "functions": {
    "api/paid-content.ts": {
      "includeFiles": "docs/content/articles/*.md"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:code",
      "destination": "/api/share?code=:code"
    },
    {
      "source": "/api/content/:slug",
      "destination": "/api/paid-content?slug=:slug"
    },
    {
      "source": "/types/compatibility",
      "destination": "/index.html"
    },
    {
      "source": "/types/:code",
      "destination": "/api/share?code=:code&render=app"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
